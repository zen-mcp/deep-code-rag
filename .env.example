# Deep Code RAG Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Local Embedding (runs fully offline, no API key needed) ──────────────────
#
# Model options:
#   BAAI/bge-small-en-v1.5  → 384 dims, ~33MB   ← DEFAULT (fast, stable)
#   BAAI/bge-base-en-v1.5   → 768 dims, ~110MB  ← more accurate
#
# Recommendation:
#   - macOS (any RAM)  → use bge-small, it runs on CPU without SIGKILL
#   - Proxmox LXC      → use bge-small for stability, bge-base if RAM > 4GB
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Batch size: number of code chunks processed at once
# Lower = less memory spike, more stable. Raise if you want faster indexing.
LOCAL_EMBEDDING_BATCH_SIZE=8

# Sleep between batches (seconds): prevents sustained 100% CPU
# 0.05 = 50ms pause between each batch (barely noticeable, keeps CPU ~60-80%)
# 0.0  = no pause (fastest, but CPU stays at 100% throughout)
# 0.2  = 200ms pause (very gentle on CPU, ~30-40% usage)
LOCAL_EMBEDDING_SLEEP=0.05
